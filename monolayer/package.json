{
  "devDependencies": {
    "@eslint/js": "^9.39.3",
    "@vitest/coverage-v8": "^4.1.12",
    "@vitest/ui": "^4.1.12",
    "dependency-cruiser": "^17.3.5",
    "eslint": "^10.1.0",
    "globals": "^17.3.0",
    "jsdoc": "^4.0.4",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "docs": "jsdoc -c jsdoc.conf.json && open docs/index.html ",
