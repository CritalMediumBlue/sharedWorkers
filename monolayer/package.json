    "test": "vitest --ui --watch",
    "batch": "node --max-old-space-size=8192 --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/batch.mjs"
  },
  "dependencies": {
    "@dimforge/rapier2d-compat": "^0.19.3",
    "chart.js": "^4.5.1",
    "handy-diffusion": "^1.0.10",
    "three": "^0.182.0",
    "tweakpane": "^4.0.5"
  }
}
